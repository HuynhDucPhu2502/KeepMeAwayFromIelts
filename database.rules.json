{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('hostUid').val() === auth.uid && !newData.exists()",
        "hostUid": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('hostUid').exists()",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16"
          }
        },
        "$field": {
          ".write": "auth != null && newData.parent().child('hostUid').val() === auth.uid"
        }
      }
    }
  }
}
